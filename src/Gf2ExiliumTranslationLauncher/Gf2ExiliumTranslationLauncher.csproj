<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets/Launcher.ico</ApplicationIcon>
        <AssemblyName>Gf2ExiliumTranslationLauncher</AssemblyName>
        <RootNamespace>Gf2ExiliumTranslationLauncher</RootNamespace>
        <AssemblyTitle>GF2 Exilium Translation Launcher</AssemblyTitle>
        <Product>GF2 Exilium Translation Launcher</Product>
        <Company>GF2 Exilium Translation Launcher Contributors</Company>
        <Authors>GF2 Exilium Translation Launcher Contributors</Authors>
        <Description>Girls' Frontline 2 translation updater and launcher.</Description>
        <Copyright>Copyright (c) 2026 GF2 Exilium Translation Launcher Contributors</Copyright>
        <NeutralLanguage>en-US</NeutralLanguage>
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <InformationalVersion>1.0.0</InformationalVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' and '$(SelfContained)' == 'true'">
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
        <PackageReference Include="protobuf-net" Version="3.2.56" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Assets/Launcher.ico" LogicalName="Gf2ExiliumTranslationLauncher.Launcher.ico" />
        <EmbeddedResource Include="Translations/StartupTranslation.ru.json"
                          LogicalName="Gf2ExiliumTranslationLauncher.Translations.StartupTranslation.ru.json"
                          WithCulture="false" />
    </ItemGroup>

    <Target Name="ExcludeDebugSymbolsFromReleasePublish"
            AfterTargets="ComputeFilesToPublish"
            Condition="'$(Configuration)' == 'Release'">
        <ItemGroup>
            <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                                   Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
        </ItemGroup>
    </Target>

</Project>
